# HeatPath — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Routing ────────────────────────────────────────────────────────
# Valhalla public routing API (no key required, free for non-commercial)
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de

# ── Weather ────────────────────────────────────────────────────────
# Open-Meteo (free, no key required for non-commercial use)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ── Geocoding ──────────────────────────────────────────────────────
# Nominatim (OSM geocoding, free with attribution)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=HeatPath/1.0 (WeMakeDevs hackathon; contact: your@email.com)

# ── AWS (fill only if deploying) ───────────────────────────────────
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET_NAME=heatpath-static-data
# AWS_CLOUDWATCH_LOG_GROUP=/heatpath/backend

# ── Backend ────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# CORS origins for frontend (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Pilot Area (Pune, Deccan/Shivaji Nagar) ───────────────────────
PILOT_LAT_MIN=18.490
PILOT_LAT_MAX=18.545
PILOT_LON_MIN=73.820
PILOT_LON_MAX=73.880
PILOT_CENTER_LAT=18.5204
PILOT_CENTER_LON=73.8567
PILOT_TIMEZONE=Asia/Kolkata
